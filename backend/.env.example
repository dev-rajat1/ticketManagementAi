# ==========================================
# 🚀 TicketAI Environment Configuration
# ==========================================
# ⚠️ Do NOT put your real passwords in this file.
# Copy this file to `.env` and fill in your details.
credentials
ADMIN_PASS="YOUR PASS"
ADMIN_EMAIL="YOUR ADMIN EMAIL"
# ------------------------------------------
# 🗄️ Database Configuration (Supabase PostgreSQL)
# ------------------------------------------
# Transaction pooler URL (Port 6543) - Used for Prisma connection
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/[DATABASE]?pgbouncer=true"
# Session URL (Port 5432) - Used for Prisma migrations
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DATABASE]"

# ------------------------------------------
# 🔐 Authentication & Security (JWT)
# ------------------------------------------
# Secret keys for signing JSON Web Tokens
JWT_ACCESS_SECRET="your_secure_access_secret_here"
JWT_REFRESH_SECRET="your_secure_refresh_secret_here"
# Token Expiry Configuration
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ------------------------------------------
# ⚙️ Server Configuration
# ------------------------------------------
# Port the backend server will run on (Default: 5000)
PORT=5000
# Environment: 'development' or 'production'
NODE_ENV="development"

# ------------------------------------------
# 🧠 AI Integration (Google Gemini)
# ------------------------------------------
# API Key for Google Gemini (Used for ticket summaries and sentiment analysis)
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------
# 📧 Email Integration (SMTP & IMAP)
# ------------------------------------------
# SMTP - Sending emails (e.g., ticket updates, password resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"
EMAIL_FROM="Support Desk <your-email@gmail.com>"

# IMAP - Reading emails (e.g., auto-creating tickets from incoming emails)
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="your-email@gmail.com"
IMAP_PASS="your-app-password-here"

# ------------------------------------------
# 📁 File Uploads Configuration
# ------------------------------------------
# Maximum allowed file size for attachments (in bytes) - Default 5MB
MAX_FILE_SIZE=5242880
# Directory where files will be uploaded locally
UPLOAD_DIR="./uploads"

# ------------------------------------------
# 🌐 CORS Configuration
# ------------------------------------------
# Allowed origins for frontend requests (Separate multiple URLs with commas if needed in your app.js)
CLIENT_URL="http://localhost:3000"
